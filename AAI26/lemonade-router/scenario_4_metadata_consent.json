{
  "version": "1",
  "model_name": "user.Startup-Consent-Router",
  "recipe": "collection.router",
  "components": ["Qwen3-1.7B-GGUF", "Qwen3.5-9B-GGUF"],
  "routing": {
    "candidates": ["Qwen3-1.7B-GGUF", "Qwen3.5-9B-GGUF"],
    "default_model": "Qwen3.5-9B-GGUF",
    "rules": [
      {
        "id": "no-consent-recorded",
        "match": { "metadata": { "key": "data_consent", "exists": false } },
        "route_to": "Qwen3-1.7B-GGUF",
        "outputs": { "reason": "no-consent-on-file", "action": "local-only" }
      },
      {
        "id": "consent-explicitly-denied",
        "match": { "metadata": { "key": "data_consent", "equals": "denied" } },
        "route_to": "Qwen3-1.7B-GGUF",
        "outputs": { "reason": "consent-denied", "action": "local-only" }
      },
      {
        "id": "hr-sensitive-task",
        "match": {
          "any": [
            { "metadata": { "key": "task_class", "any": ["hr", "payroll", "medical"] } },
            { "metadata": { "key": "employee_data", "equals": "true" } }
          ]
        },
        "route_to": "Qwen3-1.7B-GGUF",
        "outputs": { "reason": "sensitive-task-class", "action": "local-only" }
      },
      {
        "id": "consented-general",
        "match": { "metadata": { "key": "data_consent", "equals": "granted" } },
        "route_to": "Qwen3.5-9B-GGUF",
        "outputs": { "reason": "consent-granted" }
      }
    ]
  }
}
