{
  "version": "1",
  "model_name": "user.Benefits-Router",
  "recipe": "collection.router",
  "components": ["Qwen3-1.7B-GGUF", "fireworks.kimi-k2p6"],
  "routing": {
    "candidates": ["Qwen3-1.7B-GGUF", "fireworks.kimi-k2p6"],
    "default_model": "fireworks.kimi-k2p6",
    "rules": [
      {
        "id": "complex-benefits-comparison",
        "match": {
          "keywords_any": ["compare", "industry standard", "benchmark", "analyze", "recommend", "strategy", "optimize"]
        },
        "route_to": "fireworks.kimi-k2p6",
        "outputs": { "reason": "benefits-analysis", "tier": "cloud" }
      },
      {
        "id": "simple-benefits-rag",
        "match": {
          "any": [
            { "keywords_any": ["401k", "401(k)", "vesting", "parental leave", "PTO", "vacation", "healthcare", "dental", "vision", "FSA", "HSA", "COBRA", "open enrollment", "qualifying life event", "handbook", "policy", "copay", "deductible", "premium"] },
            { "max_chars": 400 }
          ]
        },
        "route_to": "Qwen3-1.7B-GGUF",
        "outputs": { "reason": "simple-benefits-rag", "tier": "local" }
      }
    ]
  }
}
