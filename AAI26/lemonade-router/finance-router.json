{
  "version": "1",
  "model_name": "user.Finance-Router",
  "recipe": "collection.router",
  "components": ["Qwen3.5-9B-GGUF", "fireworks.kimi-k2p6"],
  "routing": {
    "candidates": ["Qwen3.5-9B-GGUF", "fireworks.kimi-k2p6"],
    "default_model": "Qwen3.5-9B-GGUF",
    "rules": [
      {
        "id": "pii-finance-local",
        "match": {
          "any": [
            { "keywords_any": ["salary", "compensation", "equity", "ssn", "bank account"] },
            { "regex": "[A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,}" },
            { "regex": "\\$[0-9,]+(K|k|M)?" }
          ]
        },
        "route_to": "Qwen3.5-9B-GGUF",
        "outputs": { "reason": "pii-in-finance-query", "data_class": "sensitive" }
      },
      {
        "id": "simple-metric-lookup",
        "match": {
          "all": [
            { "max_chars": 250 },
            { "keywords_any": ["what is", "what's", "how much", "current", "today's"] }
          ]
        },
        "route_to": "Qwen3.5-9B-GGUF",
        "outputs": { "reason": "simple-metric-lookup", "tier": "local-fast" }
      },
      {
        "id": "deep-financial-modeling",
        "match": {
          "any": [
            { "keywords_any": ["forecast", "model", "Monte Carlo", "cohort", "sensitivity", "cap table dilution", "waterfall", "runway", "retention analysis", "recommend intervention", "retention intervention", "intervention"] },
            { "min_chars": 1500 }
          ]
        },
        "route_to": "fireworks.kimi-k2p6",
        "outputs": { "reason": "deep-financial-model", "tier": "cloud" }
      }
    ]
  }
}
