{
  "version": "1",
  "model_name": "user.Startup-Full-Router",
  "recipe": "collection.router",
  "components": ["Qwen3-1.7B-GGUF", "Qwen3.5-9B-GGUF", "fireworks.kimi-k2p6"],
  "routing": {
    "candidates": ["Qwen3-1.7B-GGUF", "Qwen3.5-9B-GGUF", "fireworks.kimi-k2p6"],
    "default_model": "Qwen3.5-9B-GGUF",
    "rules": [
      {
        "id": "pii-hard-local",
        "match": {
          "any": [
            { "metadata": { "key": "data_consent", "equals": "denied" } },
            { "metadata": { "key": "task_class", "any": ["hr", "payroll"] } },
            { "keywords_any": ["salary", "equity", "ssn", "social security", "bank account", "routing number"] },
            { "regex": "\\b[A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,}\\b" },
            { "regex": "\\$[0-9,]+(K|k)?\\b" }
          ]
        },
        "route_to": "Qwen3-1.7B-GGUF",
        "outputs": { "reason": "pii-detected", "data_class": "sensitive", "tier": "local-fast" }
      },
      {
        "id": "legal-to-powerful",
        "match": {
          "keywords_any": ["GDPR", "HIPAA", "compliance", "contract", "liability", "non-compete", "NDA", "indemnify", "fiduciary", "statute", "arbitration"]
        },
        "route_to": "fireworks.kimi-k2p6",
        "outputs": { "reason": "legal-domain-requires-accuracy", "domain": "legal", "tier": "cloud" }
      },
      {
        "id": "simple-rag-lookup",
        "match": {
          "all": [
            { "max_chars": 400 },
            { "keywords_any": ["what is", "what's", "when does", "how much", "who handles", "where can", "is there", "do we have", "does the"] }
          ]
        },
        "route_to": "Qwen3-1.7B-GGUF",
        "outputs": { "reason": "simple-rag", "tier": "local-fast" }
      },
      {
        "id": "complex-multi-source-analysis",
        "match": {
          "any": [
            { "keywords_any": ["forecast", "model", "cohort", "retention analysis", "runway", "burn rate", "sensitivity", "benchmark", "recommend intervention"] },
            { "min_chars": 2000 }
          ]
        },
        "route_to": "fireworks.kimi-k2p6",
        "outputs": { "reason": "complex-analysis", "tier": "cloud" }
      },
      {
        "id": "benefits-hr-policy",
        "match": {
          "keywords_any": ["401k", "401(k)", "vesting", "parental leave", "PTO", "vacation", "healthcare", "dental", "benefits", "handbook", "policy"]
        },
        "route_to": "Qwen3-1.7B-GGUF",
        "outputs": { "reason": "hr-benefits-rag", "tier": "local-fast" }
      },
      {
        "id": "code-generation",
        "match": {
          "keywords_any": ["write a function", "def ", "class ", "import ", "refactor", "debug", "```python", "script", "automate"]
        },
        "route_to": "Qwen3.5-9B-GGUF",
        "outputs": { "reason": "code-generation", "tier": "balanced" }
      }
    ]
  }
}
