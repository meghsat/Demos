{
  "version": "1",
  "model_name": "user.Startup-Finance-Router",
  "recipe": "collection.router",
  "components": ["Qwen3-1.7B-GGUF", "Qwen3.5-9B-GGUF", "fireworks.kimi-k2p6"],
  "routing": {
    "candidates": ["Qwen3-1.7B-GGUF", "Qwen3.5-9B-GGUF", "fireworks.kimi-k2p6"],
    "default_model": "Qwen3-1.7B-GGUF",
    "rules": [
      {
        "id": "simple-lookup",
        "match": {
          "all": [
            { "max_chars": 300 },
            { "keywords_any": ["what is", "what's", "how much", "when is", "who is", "define"] }
          ]
        },
        "route_to": "Qwen3-1.7B-GGUF",
        "outputs": { "reason": "simple-lookup", "tier": "local-fast" }
      },
      {
        "id": "medium-analysis",
        "match": {
          "any": [
            { "keywords_any": ["calculate", "summarize", "explain", "compare", "estimate"] },
            { "min_chars": 300 }
          ]
        },
        "route_to": "Qwen3.5-9B-GGUF",
        "outputs": { "reason": "medium-complexity", "tier": "local-balanced" }
      },
      {
        "id": "deep-financial-modeling",
        "match": {
          "any": [
            { "keywords_any": ["model", "forecast", "regression", "cohort", "Monte Carlo", "sensitivity analysis", "waterfall", "cap table dilution"] },
            { "min_chars": 2000 }
          ]
        },
        "route_to": "fireworks.kimi-k2p6",
        "outputs": { "reason": "deep-financial-model", "tier": "cloud" }
      }
    ]
  }
}
