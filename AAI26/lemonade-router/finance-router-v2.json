{
  "version": "1",
  "model_name": "user.Finance-Router-V2",
  "recipe": "collection.router",
  "components": ["Qwen3.5-9B-GGUF", "fireworks.kimi-k2p6", "Qwen3.5-9B-NoThinking", "embeddinggemma-300m-qat-q8_0-GGUF-Q8_0"],
  "routing": {
    "candidates": ["Qwen3.5-9B-GGUF", "fireworks.kimi-k2p6"],
    "default_model": "Qwen3.5-9B-GGUF",
    "classifiers": [
      {
        "id": "finance-topic",
        "type": "semantic_similarity",
        "model": "embeddinggemma-300m-qat-q8_0-GGUF-Q8_0",
        "reference_phrases": {
          "simple-lookup": [
            "what is our current burn rate",
            "what is the MRR today",
            "how much runway do we have",
            "what is the ARR",
            "what is the current headcount",
            "how much did we spend last month"
          ],
          "deep-modeling": [
            "run a Monte Carlo simulation on our runway",
            "model the cap table after the next funding round",
            "forecast revenue with cohort analysis",
            "calculate waterfall distribution for the exit scenario",
            "build a sensitivity analysis for burn rate assumptions",
            "recommend intervention for high churn retention",
            "analyze cap table dilution under different term sheets"
          ],
          "pii-finance": [
            "show me the salary breakdown by employee",
            "what is the equity package for this specific employee",
            "list all compensation by person",
            "employee bank account for payroll",
            "individual 401k contribution amounts"
          ]
        }
      },
      {
        "id": "complexity",
        "type": "llm",
        "model": "Qwen3.5-9B-NoThinking",
        "prompt": "You are a financial complexity classifier. Assess whether this finance request requires deep multi-step modeling and cloud-level reasoning, or is a simple metric lookup that local models can handle.\n\nClassify as COMPLEX if the request involves: statistical modeling, simulations, multi-variable forecasting, cohort analysis, cap table calculations, or requires synthesizing multiple data sources.\n\nClassify as SIMPLE if the request is a direct data lookup, a single metric question, or a short factual query.\n\nReply with exactly one label: COMPLEX or SIMPLE.",
        "labels": ["COMPLEX", "SIMPLE"],
        "default_label": "SIMPLE",
        "on_error": "match_false"
      }
    ],
    "rules": [
      {
        "id": "pii-finance-local-regex",
        "match": {
          "any": [
            { "regex": "[A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,}" },
            { "regex": "\\$[0-9,]+(K|k|M|m)?\\b" }
          ]
        },
        "route_to": "Qwen3.5-9B-GGUF",
        "outputs": { "reason": "pii-regex-finance", "data_class": "sensitive" }
      },
      {
        "id": "pii-finance-keyword-local",
        "match": {
          "keywords_any": ["salary", "compensation", "equity", "ssn", "bank account", "routing number", "payroll account"]
        },
        "route_to": "Qwen3.5-9B-GGUF",
        "outputs": { "reason": "pii-keyword-finance", "data_class": "sensitive" }
      },
      {
        "id": "pii-finance-semantic",
        "match": { "classifier": "finance-topic", "label": "pii-finance", "min_score": 0.68 },
        "route_to": "Qwen3.5-9B-GGUF",
        "outputs": { "reason": "pii-semantic-finance", "data_class": "sensitive", "classifier": "semantic" }
      },
      {
        "id": "deep-financial-modeling-keywords",
        "match": {
          "any": [
            { "keywords_any": ["forecast", "model", "Monte Carlo", "cohort", "sensitivity", "cap table dilution", "waterfall", "runway", "retention analysis", "recommend intervention"] },
            { "min_chars": 1500 }
          ]
        },
        "route_to": "fireworks.kimi-k2p6",
        "outputs": { "reason": "deep-financial-model-keywords", "tier": "cloud" }
      },
      {
        "id": "deep-model-semantic",
        "match": { "classifier": "finance-topic", "label": "deep-modeling", "min_score": 0.72 },
        "route_to": "fireworks.kimi-k2p6",
        "outputs": { "reason": "deep-finance-model-semantic", "tier": "cloud", "classifier": "semantic" }
      },
      {
        "id": "deep-model-llm-judge",
        "match": { "classifier": "complexity", "label": "COMPLEX", "min_score": 0.5 },
        "route_to": "fireworks.kimi-k2p6",
        "outputs": { "reason": "llm-judged-complex-finance", "tier": "cloud", "classifier": "llm" }
      },
      {
        "id": "simple-metric-lookup",
        "match": {
          "all": [
            { "max_chars": 300 },
            { "classifier": "finance-topic", "label": "simple-lookup", "min_score": 0.60 }
          ]
        },
        "route_to": "Qwen3.5-9B-GGUF",
        "outputs": { "reason": "simple-metric-lookup", "tier": "local-fast", "classifier": "semantic" }
      }
    ]
  }
}
